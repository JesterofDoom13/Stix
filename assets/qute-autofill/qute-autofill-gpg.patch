@@ -308,6 +311,9 @@
     created = False
     AUTOFILL_DIR.mkdir(parents=True, exist_ok=True)
     os.chmod(AUTOFILL_DIR, stat.S_IRWXU)  # 700, enforced every run
+    if GPG_PROFILES_PATH.exists():
+        os.chmod(GPG_PROFILES_PATH, stat.S_IRUSR | stat.S_IWUSR)
+        return False
     if not PROFILES_PATH.exists():
         PROFILES_PATH.write_text(TEMPLATE, encoding="utf-8")
         created = True
@@ -317,6 +323,19 @@
 
 
 def load_profiles() -> dict:
+    if GPG_PROFILES_PATH.exists():
+        try:
+            proc = subprocess.run(
+                ["gpg", "--quiet", "--batch", "--decrypt", str(GPG_PROFILES_PATH)],
+                capture_output=True, timeout=120, check=False,
+            )
+        except (OSError, subprocess.TimeoutExpired):
+            message_error("autofill: could not run gpg to decrypt profiles.toml.gpg")
+            sys.exit(1)
+        if proc.returncode != 0:
+            message_error("autofill: could not decrypt profiles.toml.gpg (cancelled?)")
+            sys.exit(1)
+        return tomllib.loads(proc.stdout.decode("utf-8", "replace"))
     with open(PROFILES_PATH, "rb") as f:
         return tomllib.load(f)
 

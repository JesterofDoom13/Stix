 # under --basedir). Unset (the normal case): the real per-user file.
 PROFILES_PATH = Path(os.environ["AUTOFILL_PROFILES"]) if os.environ.get("AUTOFILL_PROFILES") \
     else AUTOFILL_DIR / "profiles.toml"
+# Encrypted variant: if profiles.toml.gpg exists it wins and the plain file is
+# never created or read. Decrypted through gpg-agent (pinentry once per cache TTL).
+GPG_PROFILES_PATH = PROFILES_PATH.with_name(PROFILES_PATH.name + ".gpg")
 
 # Misses ("learn from misses", requirement #5) live under the *data* dir

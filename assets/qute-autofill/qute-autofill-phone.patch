 }
 
 // ---------------------------------------------------------------------
+// Split phone numbers (tel-country-code / tel-area-code / tel-local-* ...)
+// ---------------------------------------------------------------------
+section('en-us-split-phone.html (profile: us, +1 number split automatically)');
+{
+  const { doc } = runOn('en-us-split-phone.html', us, { profileName: 'us' });
+  check('tel keeps the full number', valueOf(doc, 'tel'), '+1 415 555 0100');
+  check('tel-country-code', valueOf(doc, 'cc'), '+1');
+  check('tel-area-code', valueOf(doc, 'area'), '415');
+  check('tel-local', valueOf(doc, 'local'), '5550100');
+  check('tel-local-prefix', valueOf(doc, 'prefix'), '555');
+  check('tel-local-suffix', valueOf(doc, 'suffix'), '0100');
+  check('tel-extension stays empty', valueOf(doc, 'ext'), '');
+}
+
+section('en-us-split-phone.html (profile: italia, non-+1 number, no explicit pieces)');
+{
+  const { doc } = runOn('en-us-split-phone.html', italia, { profileName: 'italia' });
+  check('tel keeps the full number', valueOf(doc, 'tel'), '+39 333 1234567');
+  for (const id of ['cc', 'area', 'local', 'prefix', 'suffix', 'ext']) {
+    check('split box "' + id + '" stays empty (not the whole number)', valueOf(doc, id), '');
+  }
+}
+
+section('en-us-split-phone.html (explicit pieces for a non-+1 number)');
+{
+  const prof = Object.assign({}, italia, {
+    phone_country_code: '+39', phone_area_code: '333',
+    phone_local_prefix: '123', phone_local_suffix: '4567', phone_extension: 12,
+  });
+  const { doc } = runOn('en-us-split-phone.html', prof, { profileName: 'italia' });
+  check('country code', valueOf(doc, 'cc'), '+39');
+  check('area code', valueOf(doc, 'area'), '333');
+  check('prefix', valueOf(doc, 'prefix'), '123');
+  check('suffix', valueOf(doc, 'suffix'), '4567');
+  check('local = prefix + suffix', valueOf(doc, 'local'), '1234567');
+  check('extension (TOML number) is filled as text', valueOf(doc, 'ext'), '12');
+}
+
+section('en-us-split-phone.html (explicit value beats the derived one)');
+{
+  const prof = Object.assign({}, us, { phone_area_code: '650' });
+  const { doc } = runOn('en-us-split-phone.html', prof, { profileName: 'us' });
+  check('area code is the explicit one', valueOf(doc, 'area'), '650');
+  check('prefix still derived', valueOf(doc, 'prefix'), '555');
+}
+
+section('split phone: national number + US country code, and field-shape edge cases');
+{
+  const nat = { given_name: 'John', phone_national: '(415) 555-0100', country_code: 'US' };
+  const { doc } = runOn('en-us-split-phone.html', nat, { profileName: 'nat' });
+  check('area code from phone_national', valueOf(doc, 'area'), '415');
+  check('suffix from phone_national', valueOf(doc, 'suffix'), '0100');
+  check('country code', valueOf(doc, 'cc'), '+1');
+
+  const dom = new JSDOM(`<form>
+    <input autocomplete="tel-country-code" maxlength="1" id="c1">
+    <select autocomplete="tel-country-code" id="c2">
+      <option value="">Code</option><option value="+39">+39</option><option value="+1">+1</option>
+    </select></form>`, { url: 'https://example.test/' });
+  QuteAutofill.run(us, { strictVisibility: false, profileName: 'us' }, dom.window.document, dom.window);
+  check('maxlength=1 country-code box gets "1" without the plus', valueOf(dom.window.document, 'c1'), '1');
+  check('country-code <select> picks the +1 option', valueOf(dom.window.document, 'c2'), '+1');
+}
+
+// ---------------------------------------------------------------------
 // Some sections above (late-field observer) are asynchronous: their checks
 // run inside a setTimeout/Promise, so the final pass/fail totals and
 // process.exit() must wait for those to settle first.

+  // Split phone numbers (autocomplete="tel-country-code", "tel-area-code",
+  // "tel-local-prefix", ...). North American (+1) numbers are split
+  // automatically from `phone` (or from `phone_national` when country_code is
+  // US/CA). For any other country the pieces must be set explicitly in the
+  // profile (phone_country_code, phone_area_code, phone_local_prefix,
+  // phone_local_suffix, phone_local); otherwise those boxes are left empty
+  // instead of each getting the whole number. Explicit values always win.
+  function nanpDigits(profile) {
+    var intl = profile.phone || '';
+    var d = intl.replace(/\D/g, '');
+    if (/^\s*\+/.test(intl) && d.length === 11 && d.charAt(0) === '1') return d.slice(1);
+    var cc = (profile.country_code || '').toUpperCase();
+    if (cc === 'US' || cc === 'CA') {
+      var n = (profile.phone_national || intl).replace(/\D/g, '');
+      if (n.length === 11 && n.charAt(0) === '1') n = n.slice(1);
+      if (n.length === 10) return n;
+    }
+    return '';
+  }
+
+  function phonePart(profile, part, meta) {
+    var explicit = profile['phone_' + part];
+    if (explicit) return String(explicit);
+    if (part === 'local' && profile.phone_local_prefix && profile.phone_local_suffix) {
+      return String(profile.phone_local_prefix) + String(profile.phone_local_suffix);
+    }
+    var n = nanpDigits(profile);
+    if (!n) return '';
+    switch (part) {
+      case 'country_code': return (meta && meta.maxLength === 1) ? '1' : '+1';
+      case 'area_code': return n.slice(0, 3);
+      case 'local_prefix': return n.slice(3, 6);
+      case 'local_suffix': return n.slice(6, 10);
+      case 'local': return n.slice(3, 10);
+      default: return '';
+    }
+  }
+

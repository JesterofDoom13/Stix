+<!DOCTYPE html>
+<html lang="en-US">
+<head><meta charset="utf-8"><title>Split phone number</title></head>
+<body>
+<h1>Contact</h1>
+<!-- Mirrors the "all supported @autocomplete" demo page: every box is labelled
+     with its own token, which also contains "tel" and used to trip the keyword
+     matcher, and the tel-ish boxes use type="tel", which used to trip the type
+     fallback. Both used to put the whole number into every box. -->
+<form id="contact">
+  <label>tel: <input type="tel" autocomplete="tel" id="tel" name="tel"></label>
+  <label>tel-country-code: <input type="text" autocomplete="tel-country-code" id="cc" name="cc"></label>
+  <label>tel-area-code: <input type="tel" autocomplete="tel-area-code" id="area" name="area"></label>
+  <label>tel-local: <input type="tel" autocomplete="tel-local" id="local" name="local"></label>
+  <label>tel-local-prefix: <input type="tel" autocomplete="tel-local-prefix" id="prefix" name="prefix"></label>
+  <label>tel-local-suffix: <input type="tel" autocomplete="tel-local-suffix" id="suffix" name="suffix"></label>
+  <label>tel-extension: <input type="tel" autocomplete="tel-extension" id="ext" name="ext"></label>
+</form>
+</body>
+</html>
